{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula",
  "version": "1.0.0",
  "identifier": "com.cute486.nebula",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nebula · 星云",
        "width": 1380,
        "height": 900,
        "minWidth": 390,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "url": "launcher.html"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
